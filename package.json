{
  "name": "sourcly",
  "version": "0.1.1",
  "private": true,
  "description": "Transparent, tunable academic source discovery. Runs entirely in the browser.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @sourcly/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "check:dist": "node scripts/check-dist.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "version:set": "node scripts/version.mjs set",
    "version:check": "node scripts/version.mjs check"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
